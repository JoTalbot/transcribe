{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JoTalbot/transcribe/schema/conversation.json",
  "title": "Transcribe Conversation Intelligence Record",
  "type": "object",
  "required": ["schema_version", "recording", "segments"],
  "properties": {
    "schema_version": {"type": "string"},
    "recording": {
      "type": "object",
      "required": ["recording_id", "source", "sha256"],
      "properties": {
        "recording_id": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
        "language": {"type": ["string", "null"]},
        "duration_seconds": {"type": ["number", "null"], "minimum": 0}
      },
      "additionalProperties": false
    },
    "segments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/segment"
      }
    },
    "speakers": {
      "type": "array",
      "items": {"$ref": "#/$defs/speakerOccurrence"}
    },
    "entities": {
      "type": "array",
      "items": {"$ref": "#/$defs/entity"}
    },
    "assertions": {
      "type": "array",
      "items": {"$ref": "#/$defs/assertion"}
    },
    "embeddings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["embedding_id", "kind", "model"],
        "properties": {
          "embedding_id": {"type": "string"},
          "kind": {"type": "string"},
          "model": {"type": "string"},
          "dimensions": {"type": "integer", "minimum": 1}
        },
        "additionalProperties": true
      }
    }
  },
  "$defs": {
    "timeRange": {
      "type": "object",
      "required": ["start", "end"],
      "properties": {
        "start": {"type": "number", "minimum": 0},
        "end": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": ["evidence_id", "recording_id", "time", "confidence"],
      "properties": {
        "evidence_id": {"type": "string"},
        "recording_id": {"type": "string"},
        "segment_id": {"type": ["string", "null"]},
        "time": {"$ref": "#/$defs/timeRange"},
        "text": {"type": ["string", "null"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "method": {"type": "string"},
        "model_version": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "segment": {
      "type": "object",
      "required": ["segment_id", "time", "text"],
      "properties": {
        "segment_id": {"type": "string"},
        "time": {"$ref": "#/$defs/timeRange"},
        "speaker_occurrence_id": {"type": ["string", "null"]},
        "text": {"type": "string"},
        "language": {"type": ["string", "null"]},
        "asr_confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "topic_ids": {"type": "array", "items": {"type": "string"}},
        "entity_ids": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "speakerOccurrence": {
      "type": "object",
      "required": ["speaker_occurrence_id", "label"],
      "properties": {
        "speaker_occurrence_id": {"type": "string"},
        "label": {"type": "string"},
        "voice_cluster_id": {"type": ["string", "null"]},
        "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
      },
      "additionalProperties": true
    },
    "entity": {
      "type": "object",
      "required": ["entity_id", "type", "canonical_name"],
      "properties": {
        "entity_id": {"type": "string"},
        "type": {"type": "string"},
        "canonical_name": {"type": "string"},
        "aliases": {"type": "array", "items": {"type": "string"}},
        "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
      },
      "additionalProperties": true
    },
    "assertion": {
      "type": "object",
      "required": ["assertion_id", "type", "confidence", "evidence"],
      "properties": {
        "assertion_id": {"type": "string"},
        "type": {"type": "string"},
        "subject_id": {"type": ["string", "null"]},
        "object_id": {"type": ["string", "null"]},
        "value": {},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}
      },
      "additionalProperties": true
    }
  }
}
